{
	"name": "SRES DevPod",
	"build": {
		"dockerfile": "Dockerfile",
		"context": "..",
		"cacheFrom": "ghcr.io/denniskempin/sres-dev:latest"
	},
	"runArgs": [
		"--pids-limit=512"
	],
	"mounts": [
		"source=sres-cargo-cache,target=/cargo,type=volume",
		"source=sres-target,target=/target,type=volume",
		"source=sres-gemini-state,target=/home/dev/.gemini,type=volume"
	],
	"containerEnv": {
		"CARGO_HOME": "/cargo",
		"CARGO_TARGET_DIR": "/target"
	},
	"remoteEnv": {
		"CARGO_HOME": "/cargo",
		"CARGO_TARGET_DIR": "/target"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"vadimcn.vscode-lldb",
				"rust-lang.rust-analyzer",
				"tamasfe.even-better-toml",
				"serayuzgur.crates"
			]
		}
	},
	"forwardPorts": [
		8080
	],
	"remoteUser": "dev"
}
